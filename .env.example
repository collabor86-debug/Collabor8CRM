# Server-side production/runtime configuration
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@example.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_ID=your_google_sheet_id
SESSION_SECRET=replace-with-a-long-random-secret

# Existing production login accounts
COLLABOR8_ADMIN_USERNAME=replace-with-admin-username
COLLABOR8_ADMIN_PASSWORD=replace-with-admin-password
COLLABOR8_STAFF_USERNAME=replace-with-staff-username
COLLABOR8_STAFF_PASSWORD=replace-with-staff-password

# Development/test-only login. Leave disabled unless actively testing.
DEV_TEST_LOGIN_ENABLED=false
DEV_TEST_ADMIN_ID=dev-admin-id
DEV_TEST_ADMIN_PASSWORD=dev-admin-password
DEV_TEST_MANAGER_ID=dev-manager-id
DEV_TEST_MANAGER_PASSWORD=dev-manager-password
DEV_TEST_MD_ID=dev-md-id
DEV_TEST_MD_PASSWORD=dev-md-password
DEV_TEST_OWNER_ID=dev-owner-id
DEV_TEST_OWNER_PASSWORD=dev-owner-password

# Optional services
GOOGLE_DRIVE_FOLDER_ID=
RESEND_API_KEY=
RESEND_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
